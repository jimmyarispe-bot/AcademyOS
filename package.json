{
  "name": "school-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:platform && npm run validate:crud && npm run validate:security && npm run validate:admissions && npm run validate:workflow && npm run validate:ei && npm run validate:docs && npm run validate:tests && npm run validate:ux && npm run validate:production && npm run validate:a11y && npm run validate:mobile && npm run validate:performance && npm run validate:release && npm run validate:decision && npm run validate:events && npm run validate:intelligence-graph && npm run validate:automation && npm run validate:ulr && npm run validate:hierarchy && npm run validate:execution-engine && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "perf:audit": "tsx scripts/perf-audit-p001.mts",
    "analyze": "tsx scripts/analyze-bundle.mts",
    "bundle:budget": "tsx scripts/bundle-budget.mts",
    "perf:regression": "tsx scripts/perf-regression.mts",
    "load:suite": "tsx scripts/load/suite.mts",
    "load:test": "tsx scripts/load/suite.mts",
    "load:endurance": "tsx scripts/load/suite.mts",
    "load:failure": "tsx scripts/load/suite.mts",
    "security:authz-inventory": "tsx scripts/security/authz-inventory.mts",
    "security:recovery": "tsx scripts/security/rc3-recovery.mts",
    "security:audit-deps": "npm audit --audit-level=high",
    "validate:platform": "tsx scripts/validate-platform-registry.mts",
    "validate:crud": "tsx scripts/validate-crud-standards.mts",
    "validate:security": "tsx scripts/validate-module-security.mts",
    "validate:admissions": "tsx scripts/validate-admissions-registry.mts",
    "validate:workflow": "tsx scripts/validate-platform-workflow-registry.mts && tsx scripts/validate-module-workflow.mts",
    "validate:ei": "tsx scripts/validate-ei.mts",
    "validate:docs": "tsx scripts/validate-docs.mts",
    "validate:tests": "tsx scripts/validate-tests-gate.mts",
    "validate:ux": "tsx scripts/validate-ux.mts",
    "validate:production": "tsx scripts/validate-production.mts",
    "validate:a11y": "tsx scripts/validate-a11y.mts",
    "validate:mobile": "tsx scripts/validate-mobile.mts",
    "validate:performance": "tsx scripts/validate-performance.mts",
    "validate:release": "tsx scripts/validate-release.mts",
    "validate:decision": "tsx scripts/validate-platform-decision-registry.mts",
    "validate:events": "tsx scripts/validate-platform-event-registry.mts",
    "validate:intelligence-graph": "tsx scripts/validate-platform-intelligence-graph-registry.mts",
    "validate:automation": "tsx scripts/validate-platform-automation-registry.mts",
    "validate:ulr": "tsx scripts/validate-platform-ulr-registry.mts",
    "validate:hierarchy": "tsx scripts/validate-platform-hierarchy-registry.mts",
    "validate:execution-engine": "tsx scripts/validate-platform-execution-engine.mts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "playwright test --project=smoke",
    "test:acceptance": "playwright test --project=acceptance",
    "test:acceptance-auth": "playwright test --project=setup --project=acceptance-auth",
    "test:a11y": "playwright test --project=setup --project=a11y",
    "test:mobile": "playwright test --project=mobile --project=mobile-iphone",
    "test:e2e": "playwright test --project=smoke --project=acceptance --project=a11y",
    "acceptance:rc4": "tsx scripts/acceptance/suite.mts",
    "rc5:rls": "tsx scripts/rc5/rls-soak.mts",
    "rc5:restore": "tsx scripts/rc5/restore-rehearsal.mts",
    "rc5:deploy": "tsx scripts/rc5/deploy-rehearsal.mts",
    "rc5:rollback": "tsx scripts/rc5/rollback-rehearsal.mts",
    "rc5:suite": "tsx scripts/rc5/suite.mts",
    "acceptance:rc5": "tsx scripts/rc5/suite.mts",
    "rc10:suite": "tsx scripts/rc10/suite.mts",
    "acceptance:rc10": "tsx scripts/rc10/suite.mts",
    "rc11:suite": "tsx scripts/rc11/suite.mts",
    "acceptance:rc11": "tsx scripts/rc11/suite.mts",
    "cert:instructions": "node scripts/certification-run-instructions.mjs",
    "db:baseline:build": "node scripts/greenfield/build-greenfield-baseline.mjs",
    "db:baseline:verify": "node scripts/greenfield/verify-greenfield-baseline.mjs",
    "db:baseline:inventory": "node scripts/greenfield/verify-canonical-inventory.mjs",
    "db:bootstrap:greenfield": "node scripts/greenfield/bootstrap-greenfield.mjs",
    "db:bootstrap:verify": "node scripts/greenfield/verify-greenfield-live.mjs",
    "db:migrate:forward": "node scripts/greenfield/apply-forward-migrations.mjs",
    "test:greenfield": "vitest run tests/unit/greenfield",
    "heygen:videos": "tsx scripts/heygen/cli.mts",
    "jag-learn:ingest-videos": "tsx scripts/jag-learn/ingest-heygen-videos.mts"
