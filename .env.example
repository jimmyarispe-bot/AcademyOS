# AcademyOS / JAG — environment template (safe placeholders only).
# Copy to .env.local for development. Never commit real secrets.
# Canonical contract: src/lib/platform/env/schema.ts
# Human guide: docs/launch/PRODUCTION_ENV.md

# --- Required in all environments ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Required in production / preview (also enforced by instrumentation on `next start`) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
CRON_SECRET=replace-with-long-random-secret
VAULT_ENCRYPTION_KEY=replace-with-at-least-32-characters!!
RESEND_API_KEY=
EMAIL_FROM=noreply@theacademyway.org
RESEND_FROM_NAME=The Academy Way
# Legacy alias (optional): RESEND_FROM_EMAIL=noreply@theacademyway.org

# --- Optional ---
ENFORCE_MFA=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=

# Dev-only — never set in production
ALLOW_SQUARE_PLANNED=
EXEC_OPERATING_MODE=
ALLOW_EXEC_DEMO_MODE=

# Observability (RC-1)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=jag
OBSERVABILITY_LOG_LEVEL=info
NEXT_PUBLIC_RUM_SAMPLE_RATE=1
OBSERVABILITY_SLOW_QUERY_MS=500

# Local HeyGen video tooling (scripts/heygen) — never commit real values
# Avatar display: Mr. Jag · model Avatar IV · voice Sawyer · 1080p
# Spoken scripts use "Mr. J-A-G" for pronunciation; written brand remains Mr. Jag / The Jag
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# HEYGEN_API_BASE_URL=https://api.heygen.com

# Load / Playwright tooling
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
LOAD_TEST_BASE_URL=
LOAD_TEST_COOKIE=
LOAD_TEST_EMAIL=
LOAD_TEST_PASSWORD=

# RC-4 / RC-5 acceptance (never commit real passwords)
RC4_BASE_URL=
RC4_E2E_COOKIE=
RC5_BASE_URL=
RC5_FOUNDER_EMAIL=
RC5_FOUNDER_PASSWORD=
RC5_CEO_EMAIL=
RC5_CEO_PASSWORD=
RC5_SCHOOL_LEADER_EMAIL=
RC5_SCHOOL_LEADER_PASSWORD=
RC5_TEACHER_EMAIL=
RC5_TEACHER_PASSWORD=
RC5_PARENT_EMAIL=
RC5_PARENT_PASSWORD=
RC5_STUDENT_EMAIL=
RC5_STUDENT_PASSWORD=
RC5_EMPLOYEE_EMAIL=
RC5_EMPLOYEE_PASSWORD=
RC5_RLS_A_COOKIE=
RC5_RLS_B_COOKIE=
RC5_RESTORE_BASE_URL=
RC5_DEPLOY_BASE_URL=
RC5_RUN_BUILD=
RC5_ROLLBACK_CONFIRMED=
